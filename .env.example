# JDoodle Compiler API credentials. Keep these server-side and out of source control.
JDOODLE_CLIENT_ID=your-jdoodle-client-id
JDOODLE_CLIENT_SECRET=your-jdoodle-client-secret

# Development only: use the local compiler runner when JDoodle credentials are unset.
# This does not sandbox untrusted submitted programs.
LOCAL_CODE_EXECUTION=false
