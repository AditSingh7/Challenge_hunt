# Optional remote sandboxed code execution service.
# Set both values to enable Codebox for submissions.
CODEBOX_URL=https://codebox.example.com
CODEBOX_AUTH_TOKEN=replace-with-your-codebox-auth-token

# Development only: use the legacy local compiler runner when Codebox is unset.
# This does not sandbox untrusted submitted programs.
LOCAL_CODE_EXECUTION=false